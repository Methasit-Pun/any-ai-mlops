# ============================================
# any-ai-mlops - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Read-only access to the SAME Postgres database any-ai-backend uses.
# This service never writes to this database.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# MLflow tracking server (see docker-compose.mlops.yml)
MLFLOW_TRACKING_URI=http://localhost:5000

# Used by the LLM-as-judge in evaluate_quality.py
OPENAI_API_KEY=sk-xxx
JUDGE_MODEL=gpt-4o-mini

# Path to the local checkpoint file used by log_experiment.py to avoid double-counting
CHECKPOINT_PATH=./checkpoint.json
