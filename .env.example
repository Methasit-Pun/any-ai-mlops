# ============================================
# any-ai-mlops - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Read-only access to the SAME Postgres database any-ai-backend uses.
# This service never writes to this database.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# MLflow tracking server.
# Local dev: use docker-compose.mlops.yml → http://localhost:5000
# CI / hosted: use your DagsHub endpoint → https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow

# Used by the LLM-as-judge in evaluate_quality.py
GOOGLE_API_KEY=AIzaSy-xxx
JUDGE_MODEL=gemini-2.5-flash

# Path to the local checkpoint file used by log_experiment.py to avoid double-counting
CHECKPOINT_PATH=./checkpoint.json
